# Think4U HRMS — 生產環境變數樣板
# 複製為 .env.prod 後再填入實際值

# Django
DEBUG=False
SECRET_KEY=請改成 50 字元隨機字串
ALLOWED_HOSTS=hrms.your-domain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hrms.your-domain.com

# 資料庫
DB_NAME=think4u_hrms
DB_USER=think4u
DB_PASSWORD=請改成強密碼

# 打卡 TOTP secret（必須為合法 Base32：A-Z + 2-7）
DAILY_VERIFICATION_CODE_SECRET=請改成 32 字元 Base32 字串例如 JBSWY3DPEHPK3PXPHRMS2026SECRETXX

# Email（給加班 / 請假通知用；可選 SMTP 服務商或 Gmail App Password）
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=hrms-noreply@your-domain.com
EMAIL_HOST_PASSWORD=請改成 App Password
